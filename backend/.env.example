# AnnaSathi AI Backend Environment Variables
NODE_ENV=development
PORT=5000

# Client Application URL for CORS allowlisting
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Platform Credentials (For Storage and Realtime only, NOT Supabase Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=annasathi-media

# Brevo (Sendinblue) Transactional Email & OTP Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=verify@annasathi.org
BREVO_SENDER_NAME=AnnaSathi AI Security

# Cryptographic Secrets (Use minimum 32-character random strings)
SESSION_SECRET=change-this-in-production-to-a-very-secure-random-secret-key-32chars
OTP_HMAC_SECRET=change-this-in-production-to-a-secret-hmac-key-for-otp-challenges
CSRF_SECRET=change-this-in-production-to-a-random-csrf-token-secret-key-32chars

# Python FastAPI Microservice Connection
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=internal-ai-service-shared-secret-key

# AI Chatbot Providers (Configurable: gemini | nvidia_nim)
AI_PROVIDER=gemini
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Cookie Domain (Leave empty in local development; set to .yourdomain.com in production)
COOKIE_DOMAIN=
